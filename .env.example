# Copy this file to .env and replace every placeholder.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/4sworks
# Set to true only if your hosted PostgreSQL provider requires SSL.
PGSSL=false
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@example.com
# Create the first admin using: npm run admin:create
# The script will prompt for the password securely in the terminal.
